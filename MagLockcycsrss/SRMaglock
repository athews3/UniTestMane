(* NOTE: requires new locals in GX Works3's variable table (not shown in this
   plain-text export): cycleDoneEdge, prevCycleDone : BOOL;
   latchTimeoutRise, prevLatchTimeout : BOOL;
   tLatchTimeout : TON;
   and new VAR_OUTPUT: Pass_Pulse : BOOL; Fail_Pulse : BOOL.
   Fail_Pulse was previously missing entirely from this FB's outputs -- only
   Pass_Pulse existed -- so no cycle failure could ever be counted for this
   test regardless of what happened on the machine. *)

(* ---------------- Start + Self-hold ---------------- *)
tStart(IN := ((X0 AND X17 AND NOT M2 AND M4) OR M21) AND NOT M1 AND M4, PT := T#1s);

IF tStart.Q THEN
    M21 := TRUE;
ELSE
    IF NOT X0 THEN
        M21 := FALSE;
    END_IF;
END_IF;


(* ---------------- AUX Output ---------------- *)
tAux(IN := ((tStart.Q AND X17) OR Y1) AND NOT M22 AND M4, PT := T#15s);

IF tAux.Q THEN
    Y1 := TRUE;
ELSE
    IF NOT tStart.Q THEN
        Y1 := FALSE;
    END_IF;
END_IF;


(* ---------------- Latch stage ---------------- *)
tLatch(IN := ((tAux.Q AND X17) OR M22) AND NOT M1 AND M4, PT := T#1s);

IF tLatch.Q THEN
    M22 := TRUE;
ELSE
    IF NOT tAux.Q THEN
        M22 := FALSE;
    END_IF;
END_IF;


(* ---------------- Reset Output ---------------- *)
tReset(IN := ((tLatch.Q AND NOT X0 AND X17) OR Y2) AND NOT M20 AND M4, PT := T#2s);

IF tReset.Q THEN
    Y2 := TRUE;
ELSE
    IF NOT tLatch.Q THEN
        Y2 := FALSE;
    END_IF;
END_IF;


(* ---------------- Main Hold ---------------- *)
tHold(IN := ((tReset.Q AND X17) OR M20) AND NOT M1 AND M4, PT := T#20s);

IF tHold.Q THEN
    M20 := TRUE;
ELSE
    IF NOT tReset.Q THEN
        M20 := FALSE;
    END_IF;
END_IF;


(* ---------------- Key Actuator ---------------- *)
tKey(IN := ((tHold.Q AND X17) OR Y0) AND NOT M23 AND M4, PT := T#2s);

IF tKey.Q THEN
    Y0 := TRUE;
ELSE
    IF NOT tHold.Q THEN
        Y0 := FALSE;
    END_IF;
END_IF;


(* ---------------- Final latch ---------------- *)
tFinalize(IN := ((tKey.Q AND X17) OR M23) AND NOT M1 AND M4, PT := T#2s);

IF tFinalize.Q THEN
    M23 := TRUE;
ELSE
    IF NOT tKey.Q THEN
        M23 := FALSE;
    END_IF;
END_IF;


(* ---------------- Latch Timeout Detection (fail path) ---------------- *)
(* tReset's own IN requires NOT X0 (door must clear) after the latch stage
   trips. tLatch.Q self-holds via M22 once it fires, so if X0 never clears,
   tReset never starts and the whole chain stalls indefinitely past tLatch.
   This dedicated TON measures how long the latch stage has been waiting on
   X0 to clear; if X0 is still asserted after this new 5s window, treat the
   cycle as failed. Edge-detected so Fail_Pulse is a genuine one-scan pulse. *)
tLatchTimeout(IN := (tLatch.Q AND X0 AND X17 AND M4), PT := T#5s);

latchTimeoutRise := tLatchTimeout.Q AND NOT prevLatchTimeout;
prevLatchTimeout := tLatchTimeout.Q;


(* ---------------- Cycle Complete (one-scan pulse, not a permanent latch) ---------------- *)
cycleDoneEdge := (tFinalize.Q AND X0 AND M4) AND NOT prevCycleDone;
prevCycleDone := (tFinalize.Q AND X0 AND M4);

(* AND NOT latchTimeoutRise is a defensive interlock, not just a byproduct of
   X0 timing: CycleCount must never increment on the same scan Fail_Pulse
   does, so this is made explicit rather than relying on the two edge
   conditions happening to be mutually exclusive today. *)
IF cycleDoneEdge AND NOT latchTimeoutRise THEN
    M1 := TRUE;
    CycleCount := CycleCount + 1;
    Pass_Pulse := TRUE;
ELSE
    M1 := FALSE;
    Pass_Pulse := FALSE;
END_IF;

IF latchTimeoutRise THEN
    Fail_Pulse := TRUE;
ELSE
    Fail_Pulse := FALSE;
END_IF;


(* ---------------- Goal Reached ---------------- *)
IF (CycleCount >= CycleTarget) AND (CycleTarget > 0) THEN
    SET(M2);
END_IF;
