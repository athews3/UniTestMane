(* NOTE: requires new locals in GX Works3's variable table (not shown in this
   plain-text export): failRetractRise, prevFailRetract : BOOL;
   cycleDoneEdge, prevCycleDone : BOOL;
   and new VAR_OUTPUT: CyclePass_Pulse, CycleFail_Pulse : BOOL.
   The undeclared/orphaned M5 fail-limit trip and the direct FailtoRet write
   have been removed — the manager now owns fail counting via CycleFail_Pulse
   (see UniTestManref.txt's failure-tracking block). The dead D200 write has
   been replaced with the actual CycleCount label so cycles now really count. *)

(* ---------------- Precondition / Start Delay ---------------- *)
tStartDelay(IN := (X0 AND X17 AND NOT M1 AND NOT M2 AND M4), PT := T#1s);

(* ---------------- Pushbar / Unpowered State ---------------- *)
IF (M6 AND NOT M7 AND X17 AND M4) THEN
    Y1 := TRUE;   (* Pushbar *)
ELSE
    Y1 := FALSE;
END_IF;

(* ---------------- QEL Output ---------------- *)
IF (M8 AND NOT M6 AND X17 AND M4) THEN
    Y0 := TRUE;   (* QEL *)
ELSE
    Y0 := FALSE;
END_IF;

(* ---------------- Power Enable + Hold ---------------- *)
tPowerHold(IN := ((tStartDelay.Q AND X17 AND NOT M9 AND NOT M1) OR M8 AND M4), PT := T#800ms);

IF (tPowerHold.Q) THEN
    M8 := TRUE;
ELSE
    IF NOT tStartDelay.Q THEN
        M8 := FALSE;
    END_IF;
END_IF;

(* ---------------- Fail-to-Retract Detection ---------------- *)
tFailRetract(IN := ((Y0 AND X0 AND X17 AND tPowerHold.Q AND NOT M1) OR M10 AND M4), PT := T#2s);

IF (tFailRetract.Q) THEN
    M10 := TRUE;
ELSE
    IF NOT Y0 THEN
        M10 := FALSE;
    END_IF;
END_IF;

(* ---------------- Fail Counter (edge-pulsed, not level-driven) ---------------- *)
failRetractRise := tFailRetract.Q AND NOT prevFailRetract;
prevFailRetract := tFailRetract.Q;

IF (failRetractRise AND X17 AND NOT M9 AND M4) THEN
    M16 := TRUE;
    CycleFail_Pulse := TRUE;
ELSE
    M16 := FALSE;
    CycleFail_Pulse := FALSE;
END_IF;

(* ---------------- Power Break ---------------- *)
tPowerBreak(IN := (((tPowerHold.Q AND X17 AND NOT X0 AND NOT M1) OR M9) OR (tFailRetract.Q AND M16) AND M4), PT := T#800ms);

IF (tPowerBreak.Q) THEN
    M9 := TRUE;
ELSE
    IF NOT tPowerHold.Q THEN
        M9 := FALSE;
    END_IF;
END_IF;

(* ---------------- Unpowered Pushbar ---------------- *)
tUnpowered(IN := ((tPowerBreak.Q AND X17 AND NOT M1) OR M6 AND M4), PT := T#800ms);

IF (tUnpowered.Q) THEN
    M6 := TRUE;
ELSE
    IF NOT tPowerBreak.Q THEN
        M6 := FALSE;
    END_IF;
END_IF;

(* ---------------- Re-engage ---------------- *)
tReengage(IN := ((tUnpowered.Q AND X0 AND X17 AND NOT M1) OR M7 AND M4), PT := T#800ms);

IF (tReengage.Q) THEN
    M7 := TRUE;
ELSE
    IF NOT tUnpowered.Q THEN
        M7 := FALSE;
    END_IF;
END_IF;

(* ---------------- Cycle Complete (one-scan pulse, not a permanent latch) ---------------- *)
cycleDoneEdge := (tReengage.Q AND X17 AND M4) AND NOT prevCycleDone;
prevCycleDone := (tReengage.Q AND X17 AND M4);

IF cycleDoneEdge THEN
    M1 := TRUE;
    CycleCount := CycleCount + 1;
    CyclePass_Pulse := TRUE;
ELSE
    M1 := FALSE;
    CyclePass_Pulse := FALSE;
END_IF;

(* ---------------- Goal Reached ---------------- *)
IF (CycleCount >= CycleTarget) AND (CycleTarget > 0) THEN
    SET(M2);
END_IF;
