\date{}

\begin{document}

\maketitle

\section*{Overview}
Universal Test Manager is a PLC-driven test management system built on the Mitsubishi automation stack. It integrates machine control, operator interface, and test workflow execution using:
\begin{itemize}[noitemsep]
    \item GX Works3 -- PLC programming environment
    \item GT Designer3 -- HMI (GOT) design environment
\end{itemize}

The system provides a structured and reusable framework for automated test sequencing, data handling, and operator interaction.

\section*{Architecture}

\subsection*{Core Components}

\textbf{PLC Logic (GX Works3)}
\begin{itemize}[noitemsep]
    \item Sequencing, interlocks, and control logic
    \item Test state management and timing
    \item Physical I/O and external device interface
\end{itemize}

\textbf{HMI Interface (GT Designer3)}
\begin{itemize}[noitemsep]
    \item Operator interaction and visualization
    \item Test configuration and manual controls
    \item Status display, alarms, and diagnostics
\end{itemize}

\textbf{Test Manager Layer}
\begin{itemize}[noitemsep]
    \item Abstracted test flow control
    \item Standardized structure for test expansion
    \item Scalable across multiple stations
\end{itemize}

\section*{Features}
\begin{itemize}[noitemsep]
    \item Modular test sequence structure
    \item Configurable parameters
    \item Real-time diagnostics and status feedback
    \item Pass/fail evaluation logic
    \item Expandable architecture
\end{itemize}

\section*{Repository Structure}

\begin{verbatim}
/PLC    -> GX Works3 project files
/HMI    -> GT Designer3 project files
/Docs   -> Supporting documentation (optional)
\end{verbatim}

\section*{Requirements}

\subsection*{Software}
\begin{itemize}[noitemsep]
    \item GX Works3
    \item GT Designer3 (GT Works3 suite)
\end{itemize}

\subsection*{Hardware}
\begin{itemize}[noitemsep]
    \item Mitsubishi PLC (iQ-R, iQ-F, or compatible)
    \item Mitsubishi GOT HMI
\end{itemize}

\section*{Getting Started}

\subsection*{PLC Setup}
\begin{enumerate}[noitemsep]
    \item Open GX Works3
    \item Load project from \texttt{/PLC}
    \item Verify PLC model, I/O, and communications
    \item Build and download to target PLC
\end{enumerate}

\subsection*{HMI Setup}
\begin{enumerate}[noitemsep]
    \item Open GT Designer3
    \item Load project from \texttt{/HMI}
    \item Verify communication settings
    \item Download to GOT terminal
\end{enumerate}

\section*{System Operation}
\begin{enumerate}[noitemsep]
    \item Power PLC and HMI
    \item Establish communication
    \item Operator initiates test sequence
    \item PLC executes test logic
    \item Results and diagnostics displayed on HMI
\end{enumerate}

\section*{Development Workflow}

\textbf{PLC Modifications}
\begin{itemize}[noitemsep]
    \item Update logic in GX Works3
    \item Maintain structured state-machine approach
    \item Validate before deployment
\end{itemize}

\textbf{HMI Modifications}
\begin{itemize}[noitemsep]
    \item Update screens in GT Designer3
    \item Align device addressing with PLC
    \item Maintain consistent UI behavior
\end{itemize}

\section*{Design Principles}
\begin{itemize}[noitemsep]
    \item Modularity
    \item Deterministic execution
    \item Operator clarity
    \item Maintainability
\end{itemize}

\section*{Notes}
\begin{itemize}[noitemsep]
    \item Proprietary Mitsubishi formats require compatible software versions
    \item Validate hardware mappings before deployment
    \item Maintain strict version control on PLC/HMI updates
\end{itemize}

