FUNCTION_BLOCK FB_Completion
VAR_INPUT
    CycleCount_In   : DWORD;
    CycleTarget_In  : DWORD;
    CPM_In          : REAL;
    CurrentTime_s   : DINT;   (* seconds, from RTC or system clock *)
END_VAR

VAR_OUTPUT
    RemainingCycles : DWORD;
    MinutesRemain   : REAL;
    CompletionTime  : DINT;   (* projected timestamp (seconds) *)
END_VAR


RemainingCycles := CycleTarget_In - CycleCount_In;

IF CPM_In > 0.0 THEN
    MinutesRemain := REAL(RemainingCycles) / CPM_In;
ELSE
    MinutesRemain := 0.0;
END_IF;

CompletionTime := CurrentTime_s + DINT(MinutesRemain * 60.0);
