FUNCTION_BLOCK FB_Completion
VAR_INPUT
    CycleCount_In  : DINT;
    CycleTarget_In : DINT;
    CPM_In         : DINT;
END_VAR

VAR_OUTPUT
    RemainingCycles : DINT;
    MinutesRemain   : DINT;
    CompletionDT    : DT;
END_VAR

VAR
    CurrentDT   : DT;
    AddSeconds  : DINT;
END_VAR


(* --- GET REAL PLC TIME --- *)
RD_SYS_T(CurrentDT);

(* --- CORE CALCULATION --- *)
RemainingCycles := CycleTarget_In - CycleCount_In;

IF CPM_In > 0 THEN
    MinutesRemain := RemainingCycles / CPM_In;
ELSE
    MinutesRemain := 0;
END_IF;

(* Convert remaining minutes to seconds *)
AddSeconds := MinutesRemain * 60;

(* --- ADD TIME USING MITSUBISHI INSTRUCTION --- *)
DTADD(
    EN  := TRUE,
    IN1 := CurrentDT,
    IN2 := AddSeconds,
    OUT := CompletionDT
);
