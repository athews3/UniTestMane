(* -------- READ SYSTEM CLOCK --------
uYear/uMonth/uDay/uHour/uMinute are NOT present in workingglobvar.csv
as of 2026-07-17 -- despite this comment previously claiming they were
confirmed, that has not actually been verified. Before this FB will
compile, confirm in GX Works3 whether this project's FX5 CPU exposes
clock data as built-in module labels (commonly
FX5CPU.stSD.stClock_Data.uYear, etc.) or whether user-defined global
labels must be created aliased to SD210-SD214, and update the names
below to match whichever is actually true for this project. FX5's RTC
data is plain binary (not BCD like FX3/Q-series), so only a WORD-to-INT
conversion should be needed either way, not BCDTOINT -- but WORD_TO_INT
itself has not been confirmed against this project's instruction
reference either. *)

Year  := FX5CPU.stSD.stClock_Data.uYear;
Month :=  FX5CPU.stSD.stClock_Data.uMonth;
Day   :=  FX5CPU.stSD.stClock_Data.uDay;
Hour  :=  FX5CPU.stSD.stClock_Data.uHour;
Min   :=  FX5CPU.stSD.stClock_Data.uMinute;


(* -------- CORE CALC -------- *)
RemainingCycles := CycleTarget_In - CycleCount_In;

IF CPM_In > 0 THEN
    MinutesRemain := RemainingCycles / CPM_In;
	ELSE
    MinutesRemain := 0;
END_IF;

AddMin := MinutesRemain;


(* -------- ADD MINUTES -------- *)

Min := Min + AddMin;

(* Minute rollover *)
Hour := Hour + (Min / 60);
Min  := Min MOD 60;

(* Hour rollover *)
Day := Day + (Hour / 24);
Hour := Hour MOD 24;


(* -------- DAY/MONTH/YEAR HANDLING -------- *)

(* Simplified month length handling *)
CASE Month OF
    1,3,5,7,8,10,12:
	WHILE Day > 31 DO
		Day := Day - 31;
		Month := Month + 1;
	END_WHILE;

    4,6,9,11:
	WHILE Day > 30 DO
		Day := Day - 30;
		Month := Month + 1;
	END_WHILE;

    2:
	(* No leap year handling – industrial simplification *)
	WHILE Day > 28 DO
		Day := Day - 28;
		Month := Month + 1;
	END_WHILE;
END_CASE;


(* Month rollover *)
WHILE Month > 12 DO
    Month := Month - 12;
    Year := Year + 1;
END_WHILE;


(* -------- OUTPUT -------- *)
Comp_Year  := Year;
Comp_Month := Month;
Comp_Day   := Day;
Comp_Hour  := Hour;
Comp_Min   := Min;
