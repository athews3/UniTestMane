FUNCTION_BLOCK FB_Completion
VAR_INPUT
    CycleCount_In  : DINT;
    CycleTarget_In : DINT;
    CPM_In         : DINT;
    CurrentTime_s  : DINT;
END_VAR

VAR_OUTPUT
    RemainingCycles : DINT;
    MinutesRemain   : DINT;
    CompletionTime  : DINT;
END_VAR


RemainingCycles := CycleTarget_In - CycleCount_In;

IF CPM_In > 0 THEN
    MinutesRemain := RemainingCycles / CPM_In;
ELSE
    MinutesRemain := 0;
END_IF;

CompletionTime := CurrentTime_s + (MinutesRemain * 60);
