FUNCTION_BLOCK FB_NextPause
VAR_INPUT
    CycleCount_In     : DWORD;
    Setpoint          : DWORD;
    Reset             : BOOL;
END_VAR

VAR_OUTPUT
    Trigger           : BOOL;
END_VAR


IF Reset THEN
    Trigger := FALSE;
END_IF;

IF (Setpoint > 0) AND (CycleCount_In >= Setpoint) THEN
    Trigger := TRUE;
END_IF;
