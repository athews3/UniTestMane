FUNCTION_BLOCK FB_CPM
VAR_INPUT
    Enable        : BOOL;
    CycleCount_In : DINT;
END_VAR

VAR_OUTPUT
    CPM           : DINT;
END_VAR

VAR
    LastCount     : DINT;
    Delta         : DINT;
    SecCounter    : DINT;
END_VAR


(* 1-second clock accumulation using FX5 system bit *)
IF Enable AND FX5CPU.stSM.b1sClock THEN
    SecCounter := SecCounter + 1;
END_IF;

(* every 60 seconds *)
IF SecCounter >= 60 THEN

    Delta := CycleCount_In - LastCount;
    CPM := Delta;

    LastCount := CycleCount_In;
    SecCounter := 0;

END_IF;
